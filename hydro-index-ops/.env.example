# 复制为 .env 后按需修改（compose 默认已内置相同默认值）
HYDRO_PG_DSN=postgresql://hydro:hydro_pw@db:5432/hydro_warehouse
HYDRO_WORK_POLL_INTERVAL=1.0
HYDRO_CLEANUP_RETRY_INTERVAL=3.0
# 仅用于演示清理失败自动重试：让前 N 次 DROP 尝试报错
HYDRO_CLEANUP_FAIL_FIRST=0
# 归档/写入路由等待按站咨询锁的最长时间（毫秒），超时返回 409 可重试
HYDRO_ARCHIVE_LOCK_TIMEOUT_MS=10000
HYDRO_LOG_LEVEL=INFO
